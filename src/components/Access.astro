---
// Choose your commitment — everyone gets the same LeverHub experience; the only
// choice is how long you learn with us. Four duration tiers on a shared timeline.
// (Replaces the earlier broker-connected access model.)
const currency = "$";

const included = ["Full LeverHub Platform", "All Courses", "Progress Coach", "Dashboard & Tools"];

const tiers = [
  {
    name: "Beginner",
    duration: "2 months",
    price: "199",
    blurb: "Perfect for getting started and building a strong foundation.",
    icon: `<path d="M12 20.5V13"/><path d="M12 13c0-3.3 2.2-5.5 6.5-5.5C18.5 11 16.3 13 12 13Z"/><path d="M12 13c0-3.3-2.2-5.5-6.5-5.5C5.5 11 7.7 13 12 13Z"/>`,
  },
  {
    name: "Intermediate",
    duration: "3 months",
    price: "299",
    blurb: "More time to strengthen your knowledge and build consistency.",
    icon: `<path d="M4 20h16"/><rect x="5.5" y="12" width="3.2" height="6" rx="0.7"/><rect x="10.4" y="8" width="3.2" height="10" rx="0.7"/><rect x="15.3" y="4.5" width="3.2" height="13.5" rx="0.7"/>`,
  },
  {
    name: "Advanced",
    duration: "6 months",
    price: "499",
    blurb: "Go deeper, practise more and develop lasting financial habits.",
    icon: `<path d="M12 3c3 1.7 4.8 5 4.8 9L14.5 14.5h-5L7.2 12c0-4 1.8-7.3 4.8-9Z"/><circle cx="12" cy="9.3" r="1.6"/><path d="M9.5 15.5c-1.3.9-2 2.6-2 4.5 1.9 0 3.6-.7 4.5-2M14.5 15.5c1.3.9 2 2.6 2 4.5-1.9 0-3.6-.7-4.5-2"/>`,
  },
  {
    name: "Expert",
    duration: "12 months",
    price: "899",
    blurb: "The complete LeverHub experience with a full year of access.",
    icon: `<path d="M3.5 8.5 8 12l4-6.5 4 6.5 4.5-3.5-1.6 9.5H5.1L3.5 8.5Z"/><path d="M5.5 20h13"/>`,
  },
];
---

<section class="section" id="access">
  <div class="container">
    <div class="section-head reveal">
      <h2>Choose your commitment<em>.</em></h2>
      <p class="lede">
        Everyone gets the same LeverHub experience. Simply choose how long you'd like to
        learn with us.
      </p>
    </div>

    <div class="timeline reveal" aria-hidden="true">
      <span class="you">You</span>
      <svg class="split" viewBox="0 0 1000 122" fill="none" preserveAspectRatio="xMidYMid meet">
        <path class="branch" d="M500 0 V36" pathLength="100" />
        <path class="branch" d="M500 36 C500 92 118 70 118 116" pathLength="100" />
        <path class="branch" d="M500 36 C500 92 372 80 372 116" pathLength="100" />
        <path class="branch" d="M500 36 C500 92 628 80 628 116" pathLength="100" />
        <path class="branch" d="M500 36 C500 92 882 70 882 116" pathLength="100" />
        <circle class="stop" cx="118" cy="116" r="5.5" />
        <circle class="stop" cx="372" cy="116" r="5.5" />
        <circle class="stop" cx="628" cy="116" r="5.5" />
        <circle class="stop" cx="882" cy="116" r="5.5" />
      </svg>
    </div>

    <div class="tiers stagger">
      {
        tiers.map((tier) => (
          <article class="tier card">
            <span class="tier-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={tier.icon} />
            </span>
            <p class="tier-name">{tier.name}</p>
            <span class="tier-dur">{tier.duration}</span>
            <p class="tier-price">
              <span class="cur">{currency}</span>{tier.price}
            </p>
            <p class="tier-blurb">{tier.blurb}</p>
            <ul>
              {included.map((item) => (
                <li>
                  <span class="check" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 12.5l5 5L20 6.5" />
                    </svg>
                  </span>
                  {item}
                </li>
              ))}
            </ul>
            <a href="#hub" class="btn btn-outline">Choose {tier.name}</a>
          </article>
        ))
      }
    </div>

    <p class="assurance reveal">
      <span class="shield" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3 5 6v5.5c0 4 3 7 7 8.5 4-1.5 7-4.5 7-8.5V6l-7-3Z" />
          <path d="M9 12l2 2 4-4" />
        </svg>
      </span>
      <strong>One platform. Everything included.</strong> No hidden fees. Cancel or change
      your plan anytime.
    </p>
  </div>
</section>

<style>
  /* Subtitle held to a single row (relaxes to normal wrapping on small screens) */
  .section-head {
    max-width: none;
  }

  .section-head .lede {
    white-space: nowrap;
    max-width: none;
    font-size: clamp(1rem, 1.9vw, 1.3rem);
  }

  @media (max-width: 900px) {
    .section-head .lede {
      white-space: normal;
    }
  }

  /* Shared timeline above the tiers — one line from "You" splitting into a
     branch for every plan, like a path fanning out. */
  .timeline {
    position: relative;
    max-width: 1040px;
    margin: 0 auto clamp(1.25rem, 2.5vw, 2rem);
  }

  .you {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    margin: 0 auto -3px;
    border-radius: 50%;
    background: var(--ink-black);
    color: var(--white);
    font-family: var(--font-sub);
    font-weight: 600;
    font-size: 0.85rem;
    box-shadow: 0 0 0 6px rgba(12, 26, 48, 0.06);
  }

  .split {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .branch {
    fill: none;
    stroke: var(--teal);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .stop {
    fill: var(--teal);
    stroke: var(--paper);
    stroke-width: 4;
  }

  /* Draw the path in as it scrolls into view */
  html.js .branch {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 0.8s var(--ease-out);
  }

  html.js .timeline.in .branch {
    stroke-dashoffset: 0;
  }

  html.js .timeline.in .branch:nth-of-type(2) { transition-delay: 0.12s; }
  html.js .timeline.in .branch:nth-of-type(3) { transition-delay: 0.18s; }
  html.js .timeline.in .branch:nth-of-type(4) { transition-delay: 0.24s; }
  html.js .timeline.in .branch:nth-of-type(5) { transition-delay: 0.3s; }

  html.js .stop {
    opacity: 0;
    transition: opacity 0.3s ease 0.55s;
  }

  html.js .timeline.in .stop {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    html.js .branch,
    html.js .stop {
      stroke-dashoffset: 0;
      opacity: 1;
      transition: none;
    }
  }

  .tiers {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    align-items: stretch;
    max-width: 1040px;
    margin-inline: auto;
  }

  .tier {
    display: grid;
    grid-template-rows: auto auto auto auto auto 1fr auto;
    gap: 0.6rem;
    padding: clamp(1.5rem, 2vw, 2rem) clamp(1.25rem, 1.8vw, 1.6rem);
    text-align: center;
    justify-items: center;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }

  .tier:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lift);
  }

  .tier-icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--teal-wash);
    color: var(--teal-deep);
    margin-bottom: 0.25rem;
  }

  .tier-icon svg {
    width: 28px;
    height: 28px;
  }

  .tier-name {
    font-family: var(--font-sub);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--ink-black);
  }

  .tier-dur {
    font-family: var(--font-sub);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--teal-ink);
    background: var(--teal-wash);
    border-radius: 999px;
    padding: 0.25rem 0.85rem;
  }

  .tier-price {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.1rem, 3vw, 2.6rem);
    line-height: 1;
    color: var(--ink-black);
    margin-top: 0.35rem;
  }

  .tier-price .cur {
    font-size: 0.55em;
    font-weight: 600;
    vertical-align: super;
    margin-right: 0.05em;
  }

  .tier-blurb {
    font-family: var(--font-sub);
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--ink-75);
    max-width: 24ch;
  }

  .tier ul {
    list-style: none;
    margin: 0.4rem 0 0.75rem;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    align-content: start;
    justify-items: start;
    width: 100%;
    max-width: 15rem;
  }

  .tier li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
    text-align: left;
  }

  .check {
    flex: none;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--teal-wash);
    color: var(--teal-deep);
  }

  .tier .btn {
    width: 100%;
  }

  .assurance {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    max-width: 1040px;
    margin: clamp(1.75rem, 3vw, 2.5rem) auto 0;
    text-align: center;
    background: var(--teal-wash);
    border-radius: var(--radius-sm);
    padding: 1rem 1.5rem;
    font-family: var(--font-sub);
    font-size: 0.92rem;
    color: var(--ink-75);
  }

  .assurance strong {
    color: var(--ink-black);
    font-weight: 600;
  }

  .shield {
    display: grid;
    place-items: center;
    color: var(--teal-deep);
    flex: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .tier:hover {
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .tiers {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }

    .timeline {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .tiers {
      grid-template-columns: 1fr;
      max-width: 360px;
    }
  }
</style>
