---
// FAQ — compact hairline accordion with oversized ghost numerals; the active
// row's numeral fills with teal. Single-open behavior.
const faqs = [
  {
    q: "What is LeverHub?",
    a: "LeverHub is an educational platform designed to help individuals build a stronger understanding on financial markets, investing, and trading. Through practical and easy-to-understand content, LeverHub explores topics including market analysis, trading strategies, risk management, budgeting, financial planning, and money management, helping learners develop the knowledge and skills.",
  },
  {
    q: "Do I need trading experience to join?",
    a: "No prior knowledge or experience is required. The learning content begins with foundational topics in personal finance, economics, financial markets, and trading, allowing learners to build their understanding progressively.",
  },
  {
    q: "What is the Progress Coach?",
    a: "A dedicated support person helping you navigate the learning journey, review your goals, and stay on track with your educational progress.",
  },
  {
    q: "How do LeverHub plans work?",
    a: "LeverHub plans give you access to different levels of the platform, including educational courses, learning tools, your personal dashboard, journal, and Progress Coach. Choose the plan that best matches your goals and upgrade as your needs evolve.",
  },
];
---

<section class="section faq" id="faq">
  <div class="container inner">
    <div class="section-head faq-head reveal">
      <span class="qghost" aria-hidden="true">?</span>
      <h2>Frequently asked questions</h2>
      <p class="lede">The short version of everything people ask before joining.</p>
    </div>

    <div class="list reveal" data-accordion>
      {
        faqs.map((item, i) => (
          <details class="item" name="faq">
            <summary>
              <span class="ghost" aria-hidden="true">0{i + 1}</span>
              <span class="q">{item.q}</span>
              <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16">
                  <path
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    d="M12 5v14M5 12h14"
                  />
                </svg>
              </span>
            </summary>
            <div class="answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--white);
    border-block: 1px solid var(--line);
  }

  .inner {
    max-width: 860px;
  }

  /* Giant ghost question mark behind the head */
  .faq-head {
    position: relative;
    padding-top: 1.5rem;
  }

  .qghost {
    position: absolute;
    top: -2.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(8rem, 16vw, 12rem);
    line-height: 1;
    color: rgba(47, 174, 155, 0.09);
    pointer-events: none;
    user-select: none;
  }

  .faq-head h2,
  .faq-head .lede {
    position: relative;
  }

  .list {
    border-top: 1px solid var(--line);
  }

  .item {
    border-bottom: 1px solid var(--line);
  }

  summary {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.35rem 0.25rem;
    cursor: pointer;
    list-style: none;
    overflow: hidden;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* Oversized ghost numeral */
  .ghost {
    flex: none;
    width: 3.2rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.6rem;
    line-height: 1;
    letter-spacing: -0.03em;
    color: rgba(12, 26, 48, 0.1);
    transition: color 0.3s ease;
    user-select: none;
  }

  .item[open] .ghost,
  summary:hover .ghost {
    color: var(--teal);
  }

  .q {
    flex: 1;
    font-family: var(--font-sub);
    font-weight: 600;
    font-size: clamp(1.02rem, 1.6vw, 1.15rem);
    color: var(--ink-black);
    transition: color 0.2s ease;
  }

  summary:hover .q {
    color: var(--teal-deep);
  }

  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--teal-wash);
    color: var(--teal-deep);
    transition: transform 0.3s var(--ease-out), background-color 0.25s ease, color 0.25s ease;
  }

  .item[open] .icon {
    transform: rotate(45deg);
    background: var(--teal-bright);
    color: var(--ink-black);
  }

  .answer {
    padding: 0 0.25rem 1.5rem calc(0.25rem + 3.2rem + 1.25rem);
  }

  .answer p {
    color: var(--ink-75);
    max-width: 58ch;
    line-height: 1.7;
  }

  html.js .item[open] .answer {
    animation: answer-in 0.35s var(--ease-out);
  }

  @keyframes answer-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html.js .item[open] .answer {
      animation: none;
    }
  }

  @media (max-width: 560px) {
    .ghost {
      width: 2.2rem;
      font-size: 1.8rem;
    }

    .answer {
      padding-left: 0.25rem;
    }
  }
</style>

<script>
  // Single-open accordion (fallback for browsers without <details name>).
  const items = [...document.querySelectorAll<HTMLDetailsElement>("[data-accordion] details")];
  items.forEach((item) =>
    item.addEventListener("toggle", () => {
      if (item.open) items.forEach((other) => other !== item && (other.open = false));
    }),
  );
</script>
