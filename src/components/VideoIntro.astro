---
// Introduction video — centered dark theater: title, lede and player all
// centered on the near-black stage with a soft teal glow.
---

<section class="section video-section on-navy" id="video">
  <div class="container">
    <div class="section-head reveal">
      <h2 class="one-row">LeverHub in two minutes</h2>
      <p class="lede">
        In just two minutes, discover how LeverHub helps you understand where you are
        today, where you want to go, and how to get there.
      </p>
    </div>

    <div class="stage reveal">
      <div class="player" data-player>
        <video preload="metadata" poster="/images/video-poster.jpg" playsinline>
          <source src="/media/leverhub-intro.mp4" type="video/mp4" />
        </video>
        <div class="poster" aria-hidden="true"></div>
        <div class="shade" aria-hidden="true"></div>
        <button class="play" type="button" data-video-cta aria-label="Play the LeverHub introduction video">
          <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
            <path fill="currentColor" d="M8 5.5v13l11-6.5-11-6.5Z"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .video-section {
    position: relative;
    overflow: hidden;
    background: var(--ink-black);
    padding-top: clamp(4.5rem, 8vw, 7rem);
    padding-bottom: clamp(5rem, 9vw, 8rem);
  }

  .stage {
    position: relative;
    max-width: 940px;
    margin-inline: auto;
  }

  .stage::before {
    content: "";
    position: absolute;
    inset: -14% -18%;
    background: radial-gradient(55% 55% at 50% 48%, rgba(52, 211, 186, 0.18) 0%, rgba(52, 211, 186, 0) 70%);
    pointer-events: none;
  }

  .player {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 2px 4px rgba(2, 8, 20, 0.4), 0 48px 96px -36px rgba(2, 8, 20, 0.9);
    background: var(--ink-black);
  }

  .player video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .poster {
    position: absolute;
    inset: 0;
    background-image: url("/images/video-poster.jpg");
    background-size: cover;
    background-position: center;
    transition: transform 0.6s var(--ease-out);
  }

  .player:hover .poster {
    transform: scale(1.03);
  }

  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 20, 40, 0.35) 0%, rgba(10, 20, 40, 0.05) 45%, rgba(10, 20, 40, 0.72) 100%);
  }

  .poster,
  .shade,
  .play {
    transition-property: opacity, visibility;
    transition-duration: 0.35s;
  }

  .player.is-playing .poster,
  .player.is-playing .shade,
  .player.is-playing .play {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border: 0;
    border-radius: 50%;
    background: var(--teal-bright);
    color: var(--ink-black);
    cursor: pointer;
    box-shadow: 0 0 0 0 rgba(52, 211, 186, 0.4);
    transition: transform 0.25s var(--ease-out), background-color 0.2s ease;
    animation: pulse 2.6s ease-out infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(52, 211, 186, 0.45);
    }
    70% {
      box-shadow: 0 0 0 24px rgba(52, 211, 186, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(52, 211, 186, 0);
    }
  }

  .play:hover {
    transform: translate(-50%, -50%) scale(1.08);
    background: var(--teal);
  }

  .play svg {
    margin-left: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .play {
      animation: none;
    }

    .player:hover .poster {
      transform: none;
    }
  }
</style>

<script>
  const player = document.querySelector("[data-player]");
  const video = player?.querySelector("video");
  document.querySelectorAll("[data-video-cta]").forEach((el) =>
    el.addEventListener("click", () => {
      if (!player || !video) return;
      player.classList.add("is-playing");
      video.controls = true;
      video.play();
    }),
  );
</script>
