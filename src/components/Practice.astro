---
// Bring everything together — navy band with an illustrative personal-dashboard
// mockup (pure HTML/CSS, no live figures, no market graphics, no profit claims).
// Per the client review the screen shows the member's learning world only:
// course progress, the four-step path, the current lesson, course areas,
// upcoming sessions and recent activity.
const features = [
  {
    label: "Track your assets",
    icon: `<path d="M4 9.5 12 4l8 5.5"/><path d="M5.5 12v5.5M9.8 12v5.5M14.2 12v5.5M18.5 12v5.5"/><path d="M4 20h16"/>`,
  },
  {
    label: "Organise your learning",
    icon: `<path d="M3.5 9 12 5l8.5 4L12 13 3.5 9Z"/><path d="M7 11v4.5c0 1.4 2.2 2.5 5 2.5s5-1.1 5-2.5V11M20.5 9v5"/>`,
  },
  {
    label: "Monitor your progress",
    icon: `<path d="M4 16.5 9.5 11l3 3L20 6.5"/><path d="M15 6.5h5V11.5"/>`,
  },
  {
    label: "Build better financial habits",
    icon: `<circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3.5 2"/>`,
  },
];

const pathSteps = [
  { label: "Where you are", status: "Completed", state: "done" },
  { label: "Understand the world", status: "In progress", state: "current" },
  { label: "Take action", status: "Up next", state: "next" },
  { label: "Work-life balance", status: "Up next", state: "next" },
];

const areas = [
  { label: "Inflation & value", value: 100 },
  { label: "Economy & daily life", value: 80 },
  { label: "Global events & markets", value: 45 },
];

const upcoming = [
  { label: "Progress Coach session", when: "Thu · 17:00" },
  { label: "Quiz · Economic cycles", when: "Fri" },
  { label: "Live Q&A · Budgeting", when: "Mon" },
];

const activity = [
  { label: "Completed · Inflation basics", when: "Today" },
  { label: "Quiz passed · Economy basics", when: "Yesterday" },
  { label: "Notes added · Lesson 3", when: "May 27" },
];
---

<section class="section practice on-navy" id="hub">
  <div class="container inner">
    <div class="copy reveal">
      <h2>Bring everything together</h2>
      <p class="body">
        Your learning journey doesn't end with the courses. LeverHub gives you a personal
        dashboard where you can organise your financial world, follow your progress and
        keep everything in one place.
      </p>
      <p class="power">One platform. One complete picture.</p>

      <ul class="features">
        {
          features.map((feature) => (
            <li>
              <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={feature.icon} />
              </span>
              {feature.label}
            </li>
          ))
        }
      </ul>

      <a href="#access" class="btn btn-teal">Explore the Dashboard</a>
    </div>

    <div class="mock-wrap reveal">
      <div class="mock" role="img" aria-label="Illustration of the LeverHub dashboard: course progress, your learning path, the current lesson, course areas, upcoming sessions and recent activity in one place">
        <div class="mock-top">
          <svg class="mock-logo" viewBox="0 0 127 156" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path fill="#ffffff" d="M101.109 0H50.5532V68.789L75.8309 51.8152V25.3138H101.109V156C115.069 156 126.386 144.666 126.386 130.686V25.3138C126.386 11.3338 115.069 0 101.109 0Z"></path>
            <path fill="#2fae9b" d="M50.5554 130.686H25.2777V0C11.3176 0 0 11.3338 0 25.3138V130.686C0 144.666 11.3176 156 25.2777 156H75.8331V82.291L50.5554 99.2648V130.686Z"></path>
          </svg>
          <span class="greet">Good morning, Alex</span>
          <span class="chip">Dashboard</span>
        </div>

        <div class="mock-grid">
          <div class="tile headline">
            <span class="tile-label">Course Progress</span>
            <span class="big-num">64<span class="unit">%</span></span>
            <span class="tile-sub">16 of 25 lessons completed</span>
          </div>

          <div class="tile">
            <span class="tile-label">Your Path</span>
            <span class="path-bar" aria-hidden="true">
              {pathSteps.map((step) => <span class={`path-seg ${step.state} grow-bar`} />)}
            </span>
            <ul class="path-key">
              {
                pathSteps.map((step) => (
                  <li class={step.state}>
                    <span class="dot" />
                    {step.label}
                    <span class="path-status">{step.status}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="tile">
            <span class="tile-label">Current Lesson</span>
            <span class="player" aria-hidden="true">
              <span class="play">
                <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M8 5.5v13l10-6.5Z" /></svg>
              </span>
              <span class="player-time">08:42 / 18:10</span>
            </span>
            <span class="lesson-title">How inflation changes the value of your savings</span>
            <span class="bar-track">
              <span class="bar-fill grow-bar" style="width:48%" />
            </span>
            <span class="tile-sub">Lesson 4 of 12 &middot; Understand the world</span>
          </div>

          <div class="tile">
            <span class="tile-label">Course Areas</span>
            {
              areas.map((area) => (
                <div class="bar-row">
                  <span class="bar-head">
                    <span>{area.label}</span>
                    <span class="pct">{area.value}%</span>
                  </span>
                  <span class="bar-track">
                    <span class="bar-fill grow-bar" style={`width:${area.value}%`} />
                  </span>
                </div>
              ))
            }
          </div>

          <div class="tile">
            <span class="tile-label">Upcoming</span>
            <ul class="mini-list">
              {
                upcoming.map((row) => (
                  <li>
                    <span class="act">{row.label}</span>
                    <span class="note">{row.when}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="tile">
            <span class="tile-label">Recent Activity</span>
            <ul class="mini-list">
              {
                activity.map((row) => (
                  <li>
                    <span class="act">{row.label}</span>
                    <span class="note">{row.when}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
      <p class="fine">Illustrative interface &mdash; not live data.</p>
    </div>
  </div>
</section>

<style>
  .practice {
    background: var(--ink-black);
    color: var(--white);
    overflow: hidden;
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .body {
    color: var(--white-75);
    font-size: 1.02rem;
  }

  .power {
    font-family: var(--font-sub);
    /* 20px/700 qualifies as WCAG large text, so teal on the navy gradient passes */
    font-weight: 700;
    color: var(--teal);
    font-size: 1.25rem;
  }

  .features {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem 1.5rem;
    width: 100%;
    max-width: 480px;
  }

  .features li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-sub);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--white-85);
  }

  .features .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(47, 174, 155, 0.5);
    color: var(--teal);
  }

  .features .icon svg {
    width: 19px;
    height: 19px;
  }

  /* ---------- dashboard mockup ---------- */

  .mock-wrap {
    position: relative;
    display: grid;
    gap: 0.9rem;
    justify-items: center;
    perspective: 1400px;
  }

  /* Soft glow behind the dashboard mock */
  .mock-wrap::before {
    content: "";
    position: absolute;
    inset: -12% -16%;
    background: radial-gradient(55% 55% at 50% 45%, rgba(47, 174, 155, 0.16) 0%, rgba(47, 174, 155, 0) 70%);
    pointer-events: none;
  }

  .mock {
    width: 100%;
    background: #081527;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    padding: 1.25rem;
    box-shadow: 0 40px 80px -30px rgba(4, 12, 28, 0.9);
    transform: rotateY(-7deg) rotateX(2deg);
    transition: transform 0.6s var(--ease-out);
  }

  .mock:hover {
    transform: rotateY(-3deg) rotateX(1deg);
  }

  .mock-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mock-logo {
    height: 20px;
    width: auto;
  }

  .greet {
    font-family: var(--font-sub);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--white-85);
  }

  .chip {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal);
    border: 1px solid rgba(47, 174, 155, 0.5);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
  }

  .mock-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.8rem;
    padding-top: 1rem;
  }

  .tile {
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 0.9rem 1rem;
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .tile-label {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--white-58);
  }

  .tile-sub {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--teal);
    letter-spacing: 0.08em;
  }

  /* Course progress headline number */
  .headline {
    align-content: center;
  }

  .big-num {
    font-family: var(--font-sub);
    font-size: 1.85rem;
    font-weight: 700;
    line-height: 1.05;
    color: var(--white);
  }

  .big-num .unit {
    font-size: 0.6em;
    font-weight: 600;
    color: var(--teal);
    margin-left: 0.08em;
  }

  /* Four-step path — segmented bar + key */
  .path-bar {
    display: flex;
    gap: 3px;
    width: 100%;
    height: 10px;
  }

  .path-seg {
    display: block;
    flex: 1;
    height: 100%;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
  }

  .path-seg.done {
    background: var(--teal-deep);
  }

  .path-seg.current {
    background: var(--teal-bright);
  }

  .path-key {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }

  .path-key li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sub);
    font-size: 0.72rem;
    color: var(--white-85);
  }

  .path-key .next {
    color: var(--white-58);
  }

  .path-key .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
    background: rgba(255, 255, 255, 0.2);
  }

  .path-key .done .dot {
    background: var(--teal-deep);
  }

  .path-key .current .dot {
    background: var(--teal-bright);
    box-shadow: 0 0 0 3px rgba(52, 211, 186, 0.2);
  }

  .path-status {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--white-58);
    white-space: nowrap;
  }

  .path-key .current .path-status {
    color: var(--teal);
  }

  /* Current lesson — mini video player */
  .player {
    position: relative;
    display: grid;
    place-items: center;
    height: 64px;
    border-radius: 8px;
    background: linear-gradient(135deg, #10294a 0%, #0f3a4f 100%);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .play {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    padding-left: 2px;
    border-radius: 50%;
    background: var(--teal-bright);
    color: var(--ink-black);
  }

  .player-time {
    position: absolute;
    right: 0.55rem;
    bottom: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    color: var(--white-58);
  }

  .lesson-title {
    font-family: var(--font-sub);
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--white-85);
  }

  .bar-row {
    display: grid;
    gap: 0.3rem;
  }

  .bar-head {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: var(--white-85);
    font-family: var(--font-sub);
  }

  .pct {
    font-family: var(--font-mono);
    color: var(--teal);
    font-size: 0.66rem;
  }

  .bar-track {
    display: block;
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    overflow: hidden;
  }

  .bar-fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--teal-deep), var(--teal));
  }

  .mini-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .mini-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.4rem 0.55rem;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 8px;
  }

  .act {
    font-family: var(--font-sub);
    font-size: 0.68rem;
    color: var(--white-85);
  }

  .note {
    font-size: 0.66rem;
    color: var(--white-58);
    white-space: nowrap;
  }

  .mock-wrap .fine {
    color: var(--white-58);
  }

  @media (prefers-reduced-motion: reduce) {
    .mock,
    .mock:hover {
      transition: none;
    }
  }

  @media (max-width: 960px) {
    .inner {
      grid-template-columns: 1fr;
    }

    .mock,
    .mock:hover {
      transform: none;
    }
  }

  @media (max-width: 480px) {
    .features {
      grid-template-columns: 1fr;
    }

    .mock-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
