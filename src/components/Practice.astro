---
// Bring everything together — navy band with an illustrative personal-dashboard
// mockup (pure HTML/CSS, no live figures, no profit claims). The dashboard pulls
// the member's whole financial world into one place: net worth, allocation,
// portfolio, learning progress, watchlist and recent activity.
const features = [
  {
    label: "Track your assets",
    icon: `<path d="M4 9.5 12 4l8 5.5"/><path d="M5.5 12v5.5M9.8 12v5.5M14.2 12v5.5M18.5 12v5.5"/><path d="M4 20h16"/>`,
  },
  {
    label: "Organise your learning",
    icon: `<path d="M3.5 9 12 5l8.5 4L12 13 3.5 9Z"/><path d="M7 11v4.5c0 1.4 2.2 2.5 5 2.5s5-1.1 5-2.5V11M20.5 9v5"/>`,
  },
  {
    label: "Monitor your progress",
    icon: `<path d="M4 16.5 9.5 11l3 3L20 6.5"/><path d="M15 6.5h5V11.5"/>`,
  },
  {
    label: "Build better financial habits",
    icon: `<circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3.5 2"/>`,
  },
];

const alloc = [
  { label: "Investments", pct: 45, color: "#34d3ba" },
  { label: "Savings", pct: 30, color: "#4f8ef7" },
  { label: "Cash", pct: 25, color: "rgba(255,255,255,0.35)" },
];

const lessons = [
  { label: "Economics basics", value: 80 },
  { label: "Market intelligence", value: 60 },
];

const watchlist = [
  { symbol: "EUR/USD", note: "Watching" },
  { symbol: "Gold", note: "Watching" },
  { symbol: "US30", note: "Watching" },
];

const activity = [
  { label: "Completed · Inflation basics", when: "Today" },
  { label: "Goal updated · New car", when: "Yesterday" },
  { label: "Snapshot refreshed", when: "May 27" },
];
---

<section class="section practice on-navy" id="practice">
  <div class="container inner">
    <div class="copy reveal">
      <h2>Bring everything together</h2>
      <p class="body">
        Your learning journey doesn't end with the courses. LeverHub gives you a personal
        dashboard where you can organise your financial world, follow your progress and
        keep everything in one place.
      </p>
      <p class="power">One platform. One complete picture.</p>

      <ul class="features">
        {
          features.map((feature) => (
            <li>
              <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={feature.icon} />
              </span>
              {feature.label}
            </li>
          ))
        }
      </ul>

      <a href="#hub" class="btn btn-teal">Explore the Dashboard</a>
    </div>

    <div class="mock-wrap reveal">
      <div class="mock" role="img" aria-label="Illustration of the LeverHub dashboard: net worth, asset allocation, portfolio, learning progress, watchlist and recent activity in one place">
        <div class="mock-top">
          <svg class="mock-logo" viewBox="0 0 127 156" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path fill="#ffffff" d="M101.109 0H50.5532V68.789L75.8309 51.8152V25.3138H101.109V156C115.069 156 126.386 144.666 126.386 130.686V25.3138C126.386 11.3338 115.069 0 101.109 0Z"></path>
            <path fill="#2fae9b" d="M50.5554 130.686H25.2777V0C11.3176 0 0 11.3338 0 25.3138V130.686C0 144.666 11.3176 156 25.2777 156H75.8331V82.291L50.5554 99.2648V130.686Z"></path>
          </svg>
          <span class="greet">Good morning, Alex</span>
          <span class="chip">Dashboard</span>
        </div>

        <div class="mock-grid">
          <div class="tile networth">
            <span class="tile-label">Net Worth</span>
            <span class="nw-num">&euro;48,250</span>
            <span class="tile-sub">Across your accounts</span>
          </div>

          <div class="tile">
            <span class="tile-label">Assets Allocation</span>
            <span class="alloc-bar" aria-hidden="true">
              {alloc.map((a) => <span class="alloc-seg grow-bar" style={`width:${a.pct}%;background:${a.color}`} />)}
            </span>
            <ul class="alloc-key">
              {
                alloc.map((a) => (
                  <li>
                    <span class="dot" style={`background:${a.color}`} />
                    {a.label}
                    <span class="alloc-pct">{a.pct}%</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="tile chart">
            <span class="tile-label">Portfolio Overview</span>
            <svg viewBox="0 0 220 70" preserveAspectRatio="none" aria-hidden="true">
              <polyline
                class="spark"
                points="0,58 28,52 55,55 85,40 115,44 145,28 180,32 220,14"
                fill="none"
                stroke="#2fae9b"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                pathLength="100"></polyline>
              <polyline
                points="0,58 28,52 55,55 85,40 115,44 145,28 180,32 220,14 220,70 0,70"
                fill="url(#mockfade)"
                stroke="none"></polyline>
              <defs>
                <linearGradient id="mockfade" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="rgba(47,174,155,0.35)"></stop>
                  <stop offset="100%" stop-color="rgba(47,174,155,0)"></stop>
                </linearGradient>
              </defs>
            </svg>
            <span class="tile-sub">Illustrative &mdash; not live data</span>
          </div>

          <div class="tile">
            <span class="tile-label">Learning Progress</span>
            {
              lessons.map((lesson) => (
                <div class="bar-row">
                  <span class="bar-head">
                    <span>{lesson.label}</span>
                    <span class="pct">{lesson.value}%</span>
                  </span>
                  <span class="bar-track">
                    <span class="bar-fill grow-bar" style={`width:${lesson.value}%`} />
                  </span>
                </div>
              ))
            }
          </div>

          <div class="tile">
            <span class="tile-label">Market Watchlist</span>
            <ul class="mini-list">
              {
                watchlist.map((row) => (
                  <li>
                    <span class="pair">{row.symbol}</span>
                    <span class="note">{row.note}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="tile">
            <span class="tile-label">Recent Activity</span>
            <ul class="mini-list">
              {
                activity.map((row) => (
                  <li>
                    <span class="act">{row.label}</span>
                    <span class="note">{row.when}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
      <p class="fine">Illustrative interface &mdash; not live market data.</p>
    </div>
  </div>
</section>

<style>
  .practice {
    background: var(--ink-black);
    color: var(--white);
    overflow: hidden;
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .body {
    color: var(--white-75);
    font-size: 1.02rem;
  }

  .power {
    font-family: var(--font-sub);
    /* 20px/700 qualifies as WCAG large text, so teal on the navy gradient passes */
    font-weight: 700;
    color: var(--teal);
    font-size: 1.25rem;
  }

  .features {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem 1.5rem;
    width: 100%;
    max-width: 480px;
  }

  .features li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-sub);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--white-85);
  }

  .features .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(47, 174, 155, 0.5);
    color: var(--teal);
  }

  .features .icon svg {
    width: 19px;
    height: 19px;
  }

  /* ---------- dashboard mockup ---------- */

  .mock-wrap {
    position: relative;
    display: grid;
    gap: 0.9rem;
    justify-items: center;
    perspective: 1400px;
  }

  /* Soft glow behind the dashboard mock */
  .mock-wrap::before {
    content: "";
    position: absolute;
    inset: -12% -16%;
    background: radial-gradient(55% 55% at 50% 45%, rgba(47, 174, 155, 0.16) 0%, rgba(47, 174, 155, 0) 70%);
    pointer-events: none;
  }

  .mock {
    width: 100%;
    background: #081527;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    padding: 1.25rem;
    box-shadow: 0 40px 80px -30px rgba(4, 12, 28, 0.9);
    transform: rotateY(-7deg) rotateX(2deg);
    transition: transform 0.6s var(--ease-out);
  }

  .mock:hover {
    transform: rotateY(-3deg) rotateX(1deg);
  }

  .mock-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mock-logo {
    height: 20px;
    width: auto;
  }

  .greet {
    font-family: var(--font-sub);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--white-85);
  }

  .chip {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal);
    border: 1px solid rgba(47, 174, 155, 0.5);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
  }

  .mock-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.8rem;
    padding-top: 1rem;
  }

  .tile {
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 0.9rem 1rem;
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .tile-label {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--white-58);
  }

  .tile-sub {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--teal);
    letter-spacing: 0.08em;
  }

  /* Net worth headline number */
  .networth {
    align-content: center;
  }

  .nw-num {
    font-family: var(--font-sub);
    font-size: 1.85rem;
    font-weight: 700;
    line-height: 1.05;
    color: var(--white);
  }

  /* Allocation stacked bar + legend */
  .alloc-bar {
    display: flex;
    width: 100%;
    height: 10px;
    border-radius: 999px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.08);
  }

  .alloc-seg {
    display: block;
    height: 100%;
  }

  .alloc-key {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }

  .alloc-key li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sub);
    font-size: 0.72rem;
    color: var(--white-85);
  }

  .alloc-key .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
  }

  .alloc-pct {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--white-58);
  }

  /* Sparkline draws in */
  .spark {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 1.6s var(--ease-out) 0.5s;
  }

  html.js .mock-wrap.in .spark,
  html:not(.js) .spark {
    stroke-dashoffset: 0;
  }

  .chart svg {
    width: 100%;
    height: 64px;
  }

  .bar-row {
    display: grid;
    gap: 0.3rem;
  }

  .bar-head {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: var(--white-85);
    font-family: var(--font-sub);
  }

  .pct {
    font-family: var(--font-mono);
    color: var(--teal);
    font-size: 0.66rem;
  }

  .bar-track {
    display: block;
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    overflow: hidden;
  }

  .bar-fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--teal-deep), var(--teal));
  }

  .mini-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .mini-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.4rem 0.55rem;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 8px;
  }

  .pair {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--white);
    letter-spacing: 0.06em;
  }

  .act {
    font-family: var(--font-sub);
    font-size: 0.68rem;
    color: var(--white-85);
  }

  .note {
    font-size: 0.66rem;
    color: var(--white-58);
    white-space: nowrap;
  }

  .mock-wrap .fine {
    color: var(--white-58);
  }

  @media (prefers-reduced-motion: reduce) {
    .spark {
      transition: none;
      stroke-dashoffset: 0;
    }

    .mock,
    .mock:hover {
      transition: none;
    }
  }

  @media (max-width: 960px) {
    .inner {
      grid-template-columns: 1fr;
    }

    .mock,
    .mock:hover {
      transform: none;
    }
  }

  @media (max-width: 480px) {
    .features {
      grid-template-columns: 1fr;
    }

    .mock-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
