---
// Positive journey strip under the hero — the LeverHub arc in four beats,
// replacing the old "what LeverHub is not" negatives with what it moves you through.
const steps = ["Understand yourself", "Understand the world", "Build knowledge", "Make better decisions"];
---

<aside class="strip on-navy" aria-label="The LeverHub journey">
  <div class="container inner">
    <p class="title">More than an academy</p>
    <ol class="flow">
      {
        steps.map((step, i) => (
          <li>
            {i > 0 && (
              <span class="arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h13M13 6.5 18.5 12 13 17.5" />
                </svg>
              </span>
            )}
            <span class="step">{step}</span>
          </li>
        ))
      }
    </ol>
  </div>
</aside>

<style>
  .strip {
    background: var(--ink-black);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-block: 1.35rem;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem clamp(1.5rem, 4vw, 3rem);
  }

  .title {
    font-family: var(--font-sub);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--white);
  }

  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem clamp(0.75rem, 2vw, 1.5rem);
  }

  .flow li {
    display: flex;
    align-items: center;
    gap: 0.55rem clamp(0.75rem, 2vw, 1.5rem);
  }

  .step {
    font-family: var(--font-sub);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--white-85);
  }

  .arrow {
    display: grid;
    place-items: center;
    color: var(--teal);
    flex: none;
  }
</style>
