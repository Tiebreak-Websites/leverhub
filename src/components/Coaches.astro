---
// Meet your Progress Coach — a 2x2 collage of real people paired with what a
// coach actually does for every member. No per-step specialisations: every
// member has access to the same real coaching support throughout the journey.
const photos = [
  "/images/people/coach-1.jpg",
  "/images/people/coach-3.jpg",
  "/images/people/coach-2.jpg",
  "/images/people/coach-4.jpg",
];

const benefits = [
  {
    title: "Answers your questions",
    body: "Get clear, personal answers when you need them.",
    icon: `<path d="M4.5 6.5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H10l-4 3.5V15.5H6.5a2 2 0 0 1-2-2Z"/><path d="M9 10h.01M12 10h.01M15 10h.01"/>`,
  },
  {
    title: "Keeps you accountable",
    body: "Stay focused with regular check-ins and follow-up.",
    icon: `<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.4"/><path d="M12 1.5V5M12 19v3.5M1.5 12H5M19 12h3.5"/>`,
  },
  {
    title: "Helps you stay on track",
    body: "Overcome challenges and keep moving forward.",
    icon: `<path d="M4 16.5 9.5 11l3 3L20 6.5"/><path d="M15 6.5h5V11.5"/>`,
  },
  {
    title: "Supports your learning journey",
    body: "Guidance, resources and motivation — all the way.",
    icon: `<circle cx="12" cy="8" r="3.2"/><path d="M5.5 20c.8-3.4 3.3-5.2 6.5-5.2s5.7 1.8 6.5 5.2"/>`,
  },
];
---

<section class="section tight coaches">
  <div class="container">
    <div class="section-head reveal">
      <h2>Meet your Progress Coach</h2>
      <p class="lede">
        Every LeverHub member has access to real Progress Coaches who provide guidance,
        answer questions and help maintain consistency throughout the learning journey.
      </p>
    </div>

    <div class="content">
      <div class="collage reveal" aria-hidden="true">
        {photos.map((src) => (
          <div class="frame">
            <img src={src} alt="" width="720" height="900" loading="lazy" />
          </div>
        ))}
      </div>

      <ul class="benefits stagger">
        {
          benefits.map((benefit) => (
            <li>
              <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={benefit.icon} />
              </span>
              <div class="text">
                <h3>{benefit.title}</h3>
                <p>{benefit.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* Subtitle balanced onto two rows (wide enough to stay 2 lines even at the
     largest lede font size) */
  .section-head {
    max-width: none;
  }

  .section-head .lede {
    max-width: 62rem;
    text-wrap: balance;
  }

  .content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  /* 2x2 portrait collage — second column dropped slightly for a gallery feel */
  .collage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.75rem, 1.5vw, 1.1rem);
  }

  .frame {
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    aspect-ratio: 4 / 5;
  }

  .collage .frame:nth-child(2),
  .collage .frame:nth-child(4) {
    transform: translateY(clamp(1rem, 3vw, 2.25rem));
  }

  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .benefits li {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 1.35rem 0.25rem;
    border-bottom: 1px solid var(--line);
  }

  .benefits li:first-child {
    border-top: 1px solid var(--line);
  }

  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--teal-wash);
    color: var(--teal-deep);
  }

  .icon svg {
    width: 24px;
    height: 24px;
  }

  .text {
    display: grid;
    gap: 0.15rem;
  }

  .text h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink-black);
  }

  .text p {
    font-family: var(--font-sub);
    font-size: 0.95rem;
    color: var(--ink-75);
    line-height: 1.5;
  }

  @media (max-width: 860px) {
    .content {
      grid-template-columns: 1fr;
      gap: clamp(2.5rem, 6vw, 3.5rem);
    }

    .collage {
      max-width: 460px;
      margin-inline: auto;
    }
  }

  @media (max-width: 420px) {
    .benefits li {
      gap: 0.85rem;
    }

    .icon {
      width: 46px;
      height: 46px;
    }
  }
</style>
